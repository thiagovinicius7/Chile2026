rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function meuEmail() {
      return request.auth.token.email.lower();
    }
    function membroDe(viagemId) {
      return logado() &&
        meuEmail() in get(/databases/$(database)/documents/viagens/$(viagemId)).data.membros;
    }

    // Cada viagem guarda a lista de e-mails que podem ver e editar (campo "membros").
    match /viagens/{viagemId} {
      allow read: if logado() && meuEmail() in resource.data.membros;
      allow create: if logado()
        && meuEmail() in request.resource.data.membros
        && request.resource.data.dono == meuEmail();
      allow update: if logado()
        && meuEmail() in resource.data.membros
        && meuEmail() in request.resource.data.membros
        && request.resource.data.dono == resource.data.dono;
      allow delete: if logado() && resource.data.dono == meuEmail();

      // Itens do roteiro.
      match /itens/{itemId} {
        allow read, write: if membroDe(viagemId);
      }

      // Documentos (seguro, passaportes...) e as partes de cada arquivo.
      match /docs/{docId} {
        allow read, write: if membroDe(viagemId);
        match /partes/{parteId} {
          allow read, write: if membroDe(viagemId)
            && (request.resource == null || request.resource.data.dados.size() <= 1000000);
        }
      }
    }
  }
}
